# ---------------------------------------------------------------------------
# Blockchain deployment settings.
#
#   cp .env.example .env
#
# Only needed when deploying to a public test network. Local development
# (`npx hardhat node` + `npm run deploy`) needs none of this.
#
# NEVER put a key that controls real funds here. .env is git-ignored.
# ---------------------------------------------------------------------------

# JSON-RPC endpoint for Sepolia. Free keys from Alchemy or Infura.
#   https://dashboard.alchemy.com  ->  https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=

# Private key of the account that deploys the contract and funds user wallets.
# Create a NEW wallet for this - do not reuse a personal one - and top it up
# from a Sepolia faucet. Include the 0x prefix.
DEPLOYER_PRIVATE_KEY=

# Optional: publishes the contract source on Etherscan via `hardhat verify`.
ETHERSCAN_API_KEY=
