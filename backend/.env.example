# ---------------------------------------------------------------------------
# Environment template.
#
#   cp .env.example backend/.env
#
# Then replace every value marked CHANGE_ME. Never commit the real .env file -
# it is excluded by .gitignore.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash).
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/decentralized_storage

# ---------------------------------------------------------------------------
# Authentication
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# File encryption - AES-256-GCM master key.
# MUST be exactly 64 hexadecimal characters (32 bytes = 256 bits).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# LIMITATION (documented for the academic implementation): a single server-side
# master key is used for every file. Losing or leaking it exposes all stored
# content, and rotating it would require re-encrypting everything. A production
# system would derive a separate key per file and hold them in a dedicated key
# management service.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=CHANGE_ME_64_hex_characters

# ---------------------------------------------------------------------------
# Decentralized storage (IPFS)
# These are the defaults for a local kubo node started with `ipfs daemon`.
# ---------------------------------------------------------------------------
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Blockchain (local development network only - no real funds are involved)
# CONTRACT_ADDRESS is printed by `npm run deploy` in the blockchain folder.
# Leave it blank to use the address recorded in the deployment file.
# ---------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=

# Uploads
MAX_FILE_SIZE_MB=10

# Enables the owner-only tamper-simulation endpoint used to demonstrate that
# integrity verification detects modified content. Set to false to disable it.
ALLOW_TAMPER_SIMULATION=true

# ---------------------------------------------------------------------------
# DEPLOYMENT ONLY - leave these alone for local development.
# See docs/DEPLOYMENT.md for the full walkthrough.
# ---------------------------------------------------------------------------

# IPFS provider: "kubo" for a local daemon, "pinata" for the hosted service a
# deployed API must use (a hosting platform runs no daemon of its own).
IPFS_PROVIDER=kubo
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Set false when deployed: there is no persistent disk to fall back to.
IPFS_ALLOW_LOCAL_FALLBACK=true

# Twelve-word phrase the per-user signing wallets are derived from.
# Blank locally means the public Hardhat test phrase is used, which is safe only
# on a local chain. The API refuses to start if that phrase is used against a
# remote network - generate a private one for any deployment.
WALLET_MNEMONIC=

# Gas top-up policy for user wallets. Local chains hand out valueless ETH
# freely; on a public testnet the faucet supply is limited, so use small values
# there (for example 0.002 / 0.01).
WALLET_MIN_BALANCE_ETH=0.05
WALLET_TOP_UP_ETH=1.0

# Confirmations to wait for before treating a transaction as final.
TX_CONFIRMATIONS=1
