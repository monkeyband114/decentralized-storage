# ---------------------------------------------------------------------------
# Frontend environment.
#
# LOCAL DEVELOPMENT: leave this file alone, or leave VITE_API_URL blank.
# Requests then go to "/api" and Vite proxies them to http://localhost:5000,
# so the browser only ever talks to one origin.
#
# DEPLOYED: set VITE_API_URL to the public address of the backend, with no
# trailing slash. On Vercel this is set in Project Settings > Environment
# Variables rather than in a file.
# ---------------------------------------------------------------------------

# VITE_API_URL=https://securechain-api.onrender.com

# Anything prefixed with VITE_ is embedded into the JavaScript bundle and is
# therefore PUBLIC. Never put a secret here - no JWT secret, no encryption key,
# no private key, no Pinata token. Those belong to the backend only.
